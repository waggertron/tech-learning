---
import { getPageTags, relativeContentHref } from '../lib/content-tags.mjs';

interface Props { tags: string[] }
const tags = getPageTags(Astro.props.tags);
---

{tags.length > 0 && (
  <nav class="content-tags not-content" aria-label="Page tags" data-content-tags data-pagefind-ignore="all">
    <span>Tags</span>
    <ul>
      {tags.map(tag => <li><a rel="tag" href={relativeContentHref(Astro.url.pathname, `posts/tags/${tag.slug}`, import.meta.env.BASE_URL)}>{tag.label}</a></li>)}
    </ul>
    <a class="all-tags" href={relativeContentHref(Astro.url.pathname, 'tags', import.meta.env.BASE_URL)}>Browse all tags</a>
  </nav>
)}

<style>
  .content-tags { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.55rem; margin-block: 0 1.5rem; font-size: var(--sl-text-sm); }
  .content-tags > span { font-weight: 600; }
  ul { display: flex; flex-wrap: wrap; gap: 0.45rem; list-style: none; padding: 0; margin: 0; }
  li { margin: 0; }
  li a { display: inline-block; padding: 0.2rem 0.55rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.3rem; text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 0.15em; }
  a:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
  .all-tags { margin-inline-start: auto; }
</style>
