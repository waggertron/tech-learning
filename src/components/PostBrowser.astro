---
const posts = Astro.locals.starlightBlog.posts;
const dateFormat = new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
});
---

<section class="post-browser not-content" data-post-browser data-pagefind-ignore="all" aria-labelledby="post-browser-title">
  <header class="post-browser__header">
    <div>
      <h2 id="post-browser-title">Posts</h2>
      <p>Project notes, experiments, and lessons from real code.</p>
    </div>
    <label class="post-browser__sort" hidden>
      Sort by
      <select name="post-sort">
        <option value="newest">Newest first</option>
        <option value="oldest">Oldest first</option>
      </select>
    </label>
  </header>
  <p class="post-browser__links"><a href="posts/">Browse the archive</a><a href="posts/series/">Explore post series</a></p>
  {posts.length === 0 ? <p>No posts yet.</p> : (
    <ol class="post-browser__list" data-post-list>
      {posts.map((post) => (
        <li data-post-date={post.createdAt.toISOString()}>
          <time datetime={post.createdAt.toISOString()}>{dateFormat.format(post.createdAt)}</time>
          <div>
            <h3><a href={post.href.replace(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/`, '')}>{post.title}</a></h3>
            {post.entry.data.description && <p>{post.entry.data.description}</p>}
            {post.entry.data.series && <span class="post-browser__series">{post.entry.data.series.order ? `Part ${post.entry.data.series.order} of ` : 'Series: '}{post.entry.data.series.slug.replaceAll('-', ' ')}</span>}
          </div>
        </li>
      ))}
    </ol>
  )}
  {posts.length > 10 && <p class="post-browser__more">Showing 10 of {posts.length} posts. <a href="posts/">View all posts</a></p>}
</section>

<script>
  function setupPostBrowsers() {
    document.querySelectorAll<HTMLElement>('[data-post-browser]').forEach((browser) => {
      if (browser.dataset.ready) return;
      const select = browser.querySelector<HTMLSelectElement>('select');
      const list = browser.querySelector<HTMLOListElement>('[data-post-list]');
      if (!select || !list) return;
      const rows = Array.from(list.querySelectorAll<HTMLElement>('[data-post-date]'));
      select.addEventListener('change', () => {
        const direction = select.value === 'oldest' ? 1 : -1;
        rows.sort((a, b) => direction * (a.dataset.postDate ?? '').localeCompare(b.dataset.postDate ?? ''));
        list.append(...rows);
      });
      select.closest('label')?.removeAttribute('hidden');
      browser.dataset.ready = 'true';
    });
  }
  setupPostBrowsers();
  document.addEventListener('astro:page-load', setupPostBrowsers);
</script>

<style>
  .post-browser { margin-block: 2.5rem 3.5rem; }
  .post-browser a { color: var(--sl-color-text-accent); text-underline-offset: 0.18em; }
  .post-browser__header { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; }
  h2, h3 { font-family: var(--hbd-font-heading); font-weight: 600; }
  h2 { margin: 0; font-size: 2.15rem; }
  .post-browser__header p { margin: 0.4rem 0 0; color: var(--sl-color-gray-2); }
  .post-browser__sort { display: grid; gap: 0.35rem; font-size: 0.9rem; white-space: nowrap; }
  .post-browser__sort[hidden] { display: none; }
  select { min-height: 2.75rem; padding: 0.4rem 2rem 0.4rem 0.7rem; border: 1px solid var(--sl-color-gray-4); border-radius: 0.35rem; color: var(--sl-color-text); background: var(--sl-color-bg); font: inherit; }
  .post-browser__links { display: flex; flex-wrap: wrap; gap: 0.7rem 1.5rem; margin-block: 1.1rem 1.5rem; }
  .post-browser__list { list-style: none; margin: 0; padding: 0; }
  .post-browser__list > li:nth-child(n + 11) { display: none; }
  .post-browser__more { font-size: 0.9rem; color: var(--sl-color-gray-2); }
  li { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 1.25rem; padding-block: 1.4rem; border-top: 1px solid var(--sl-color-hairline-light); }
  time { padding-top: 0.35rem; font-size: 0.9rem; color: var(--sl-color-gray-2); }
  h3 { margin: 0; font-size: 1.5rem; line-height: 1.25; }
  h3 a { color: var(--sl-color-text-accent); text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  li p { margin: 0.55rem 0 0; max-width: 68ch; color: var(--sl-color-gray-2); line-height: 1.55; }
  .post-browser__series { display: block; margin-top: 0.6rem; font-size: 0.8rem; color: var(--sl-color-gray-2); }
  @media (max-width: 40rem) {
    .post-browser__header { align-items: start; flex-direction: column; gap: 1rem; }
    li { grid-template-columns: minmax(0, 1fr); gap: 0.4rem; }
    h3 { font-size: 1.35rem; }
  }
</style>
