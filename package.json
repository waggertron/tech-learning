{
  "name": "tech-learning",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:swift": "node scripts/dev-with-swift-runner.mjs",
    "start": "astro dev",
    "prebuild": "bash scripts/check-secrets.sh",
    "build": "node scripts/clear-astro-cache.mjs && astro check && astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "test:react-outputs": "node --test tests/react-example-output-views.test.mjs",
    "test:swift-runner-contract": "vitest run tests/swift-runner-contract/contract.test.ts",
    "test:swift-runner-service": "node --test tests/swift-runner-service/server.test.mjs",
    "test:swift-repl": "vitest run tests/swift-repl/component.test.ts",
    "test:swift-runner-executor": "node --test tests/swift-runner-executor/runner.test.mjs",
    "swift-runner:local": "node tools/swift-runner/server.mjs",
    "test:swift-catalog-coverage": "node --test tests/swift-catalog-coverage.test.mjs",
    "test:swift-catalog-contract": "node --test tests/swift-coding-problem-contract.test.mjs",
    "test:swift-catalog-compile": "node scripts/test-swift-coding-problem-contract.mjs",
    "test:coding-problem-vectors": "node --test tests/coding-problem-test-vectors.test.mjs",
    "test:coding-problem-vector-fixtures": "node scripts/test-coding-problem-vector-fixtures.mjs",
    "sync:react-outputs": "node scripts/sync-react-example-outputs.mjs",
    "check:react-outputs": "node scripts/sync-react-example-outputs.mjs --check",
    "sync:swift-catalog-coverage": "node scripts/swift-catalog-coverage.mjs --write",
    "check:swift-catalog-coverage": "node scripts/swift-catalog-coverage.mjs --check",
    "sync:coding-problem-vectors": "node scripts/coding-problem-test-vectors.mjs --write",
    "check:coding-problem-vectors": "node scripts/coding-problem-test-vectors.mjs",
    "validate:swift-catalog-coverage": "node scripts/swift-catalog-coverage.mjs --validate",
    "validate:style": "node scripts/validate-style.mjs",
    "validate:pages": "node scripts/validate-pages.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:external-links": "node scripts/validate-external-links.mjs",
    "validate:code-examples": "node scripts/validate-code-examples.mjs",
    "validate:published-content": "node scripts/validate-published-content.mjs",
    "validate:custom-pages": "node scripts/validate-custom-pages.mjs",
    "validate:swift-repl-browser": "node scripts/validate-swift-repl.mjs",
    "validate:swift-runner-local-browser": "node scripts/validate-swift-runner-local-browser.mjs",
    "validate:pre-push": "node scripts/validate-pre-push.mjs",
    "new:topic": "bash scripts/new-topic.sh",
    "new:post": "bash scripts/new-post.sh"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/starlight": "^0.32.0",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@playwright/test": "^1.61.1",
    "@storybook/react": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "astro": "^5.3.0",
    "codemirror": "^6.0.2",
    "katex": "^0.16.46",
    "mermaid": "^11.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-native": "^0.86.0",
    "react-native-web": "^0.21.2",
    "react-router": "^8.2.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "pagefind": "^1.5.2"
  }
}
